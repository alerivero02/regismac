# Configuración del Servicio Python del Sensor ESP32
# Copiar este archivo a .env o configurar como variables de entorno del sistema

# URL del backend en producción (Render)
BACKEND_URL=https://regismac.onrender.com

# Habilitar envío de datos al backend (true/false)
SEND_TO_BACKEND=true

# Puerto serial por defecto (opcional, se puede cambiar desde la API)
# SERIAL_PORT=COM4

# Baudrate por defecto
# SERIAL_BAUD=115200
