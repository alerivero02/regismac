{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "regismac-frontend/dist",
  "installCommand": "npm ci && cd regismac-backend && npm ci && cd ../regismac-frontend && npm ci",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
