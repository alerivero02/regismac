{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "regismac-frontend/dist",
  "installCommand": "cd api && npm install && cd ../regismac-backend && npm install && npx prisma generate && cd ../regismac-frontend && npm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
