{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "regismac-frontend/dist",
  "installCommand": "npm install && cd api && npm install && cd ../regismac-backend && npm install && cd ../regismac-frontend && npm install",
  "framework": null,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "regismac-backend/src/**",
          "regismac-backend/prisma/**",
          "regismac-backend/node_modules/**"
        ]
      }
    },
    {
      "src": "regismac-frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/regismac-frontend/dist/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
